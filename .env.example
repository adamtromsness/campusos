# ═══════════════════════════════════════════════════════════════
# CampusOS Environment Variables
# Copy to .env.local: cp .env.example .env.local
# ═══════════════════════════════════════════════════════════════

# ── Database (PostgreSQL 16) ──────────────────────────────────
# Migrations connect as `campusos` (owner role). Has CREATE / ALTER / DROP
# on every tenant schema — required to apply migrations + REVOKE privileges
# from the non-owner app role.
DATABASE_URL="postgresql://campusos:campusos_dev@localhost:5432/campusos_dev?schema=platform"

# Runtime app connects as `campusos_app` (non-owner DML role). Has SELECT +
# INSERT on every tenant table but UPDATE / DELETE / TRUNCATE / ALTER are
# REVOKE'd on the 12 IMMUTABLE tables per ADR-010 (see
# packages/database/src/provision-tenant.ts::applyImmutableRevokes). Because
# the app role has no ALTER TABLE privilege it cannot DISABLE TRIGGER, so
# the trigger + REVOKE chain is defence-in-depth.
# See docs/migration-orchestration.md for the role-split rationale.
# Override DATABASE_APP_ROLE / DATABASE_APP_PASSWORD in provisioning to
# rotate; the role is recreated with the new password on every provision.
DATABASE_APP_URL="postgresql://campusos_app:campusos_app_dev@localhost:5432/campusos_dev?schema=platform"

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── Kafka ─────────────────────────────────────────────────────
KAFKA_BROKERS="localhost:9092"

# ── Auth (Keycloak) ───────────────────────────────────────────
OIDC_ISSUER="http://localhost:8080/realms/campusos"
OIDC_CLIENT_ID="campusos-api"
OIDC_CLIENT_SECRET="change-me-in-local"
JWT_SECRET="change-me-in-local-min-32-chars-long"

# ── API ───────────────────────────────────────────────────────
PORT=4000
CORS_ORIGIN="http://localhost:3000"
NODE_ENV="development"

# ── Frontend ──────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
