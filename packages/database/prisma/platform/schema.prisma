// ═══════════════════════════════════════════════════════════════
// CampusOS Platform Schema — Prisma Definition
// Schema: platform (shared across all tenants via search_path)
//
// Step 4: Foundation (organisations, schools, tenant routing, audit)
// Step 5: Identity (iam_person, platform_users, students, families)
// Step 6: IAM (roles, permissions, assignments, cache)
// ═══════════════════════════════════════════════════════════════

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["platform"]
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// STEP 4 — Foundation Tables
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

// ── Organisations ────────────────────────────────────────────
model Organisation {
  id          String   @id @db.Uuid
  name        String
  countryCode String?  @map("country_code") @db.Char(2)
  orgType     OrgType  @default(INDEPENDENT_GROUP) @map("org_type")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  schools School[]

  @@map("organisations")
  @@schema("platform")
}

enum OrgType {
  DISTRICT
  MAT
  INDEPENDENT_GROUP

  @@schema("platform")
}

// ── Schools ──────────────────────────────────────────────────
model School {
  id                   String   @id @db.Uuid
  organisationId       String?  @map("organisation_id") @db.Uuid
  name                 String
  subdomain            String   @unique
  countryCode          String   @map("country_code") @db.Char(2)
  timezone             String
  planTier             PlanTier @default(SMALL) @map("plan_tier")
  schemaName           String   @map("schema_name")
  isActive             Boolean  @default(true) @map("is_active")
  // Phase 2 polish — public enrollment search + multi-school billing.
  // latitude/longitude back the Haversine distance calc on
  // GET /enrollment/search; fullAddress is the human-readable display
  // string. sharedBillingGroupId groups schools that present a single
  // combined billing surface to families — null means each school bills
  // independently.
  latitude             Decimal? @db.Decimal(10, 8)
  longitude            Decimal? @db.Decimal(11, 8)
  fullAddress          String?  @map("full_address")
  sharedBillingGroupId String?  @map("shared_billing_group_id") @db.Uuid
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz()

  organisation Organisation?      @relation(fields: [organisationId], references: [id])
  routing      TenantRouting?
  idProviders  IdentityProvider[]

  @@index([subdomain])
  @@index([sharedBillingGroupId])
  @@map("schools")
  @@schema("platform")
}

enum PlanTier {
  SMALL
  MEDIUM
  LARGE
  ENTERPRISE

  @@schema("platform")
}

// ── Tenant Routing (ADR-031, ADR-042, ADR-044) ──────────────
model TenantRouting {
  id                 String    @id @db.Uuid
  tenantId           String    @unique @map("tenant_id") @db.Uuid
  clusterId          String    @default("primary") @map("cluster_id")
  schemaName         String    @map("schema_name")
  // Cycle 32 Step 6 — home region enforcement at the API gateway.
  // 'us-east-1' default keeps every existing tenant on the primary
  // US cluster. EU/UK tenants are migrated to 'eu-west-2' as part of
  // their onboarding (Cycle 30 governance + Cycle 32 Step 5 + 6).
  // The RegionMismatchInterceptor rejects any request whose
  // process.env.AWS_REGION doesn't match this column with HTTP 421
  // Misdirected Request.
  homeRegion         String    @default("us-east-1") @map("home_region")
  isActive           Boolean   @default(true) @map("is_active")
  isFrozen           Boolean   @default(false) @map("is_frozen")
  isMigrating        Boolean   @default(false) @map("is_migrating")
  migratedAt         DateTime? @map("migrated_at") @db.Timestamptz()
  maxConnectionsPool Int       @default(10) @map("max_connections_pool")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  school School @relation(fields: [tenantId], references: [id])

  @@map("platform_tenant_routing")
  @@schema("platform")
}

// ── Audit Log ────────────────────────────────────────────────
//
// P2-H2 Step 2 — adds data_subject_id + action_category per ADR-052.
// data_subject_id is the FERPA / GDPR identity whose data is touched by
// this action (often == actorId, but cross-personal actions like a
// parent updating their child's profile have actor=parent + data_subject
// =child). action_category is a coarse-grained classification (READ /
// MUTATE / EXPORT / ERASE / PSEUDONYMISE / GRANT / REVOKE) used by the
// DPO SAR cross-module query (Cycle 30 governance).
model AuditLog {
  id             String   @id @db.Uuid
  actorId        String?  @map("actor_id") @db.Uuid
  actorType      String   @default("HUMAN") @map("actor_type")
  action         String
  actionCategory String?  @map("action_category")
  entityType     String   @map("entity_type")
  entityId       String?  @map("entity_id") @db.Uuid
  dataSubjectId  String?  @map("data_subject_id") @db.Uuid
  tenantId       String?  @map("tenant_id") @db.Uuid
  metadata       Json?    @db.JsonB
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@index([actorId, createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@index([tenantId, createdAt(sort: Desc)])
  @@index([dataSubjectId, createdAt(sort: Desc)])
  @@map("platform_audit_log")
  @@schema("platform")
}

// ── Event Consumer Idempotency (ADR-057) ─────────────────────
//
// P2-H2 Step 1.3 — the ERD calls the discriminator column `consumer_name`;
// the code has used `consumer_group` since Cycle 2 across 35+ files. The
// rename is documented as Phase 3 ops work — the existing column name is
// load-bearing and the equivalence is documented here. Monthly RANGE
// partitioning on processed_at is also Phase 3 ops; today the table is a
// single relation with a 90-day retention worker as carry-over.
model EventConsumerIdempotency {
  id            String   @id @db.Uuid
  consumerGroup String   @map("consumer_group")
  eventId       String   @map("event_id")
  topic         String
  processedAt   DateTime @default(now()) @map("processed_at") @db.Timestamptz()

  @@unique([consumerGroup, eventId])
  @@index([processedAt])
  @@map("platform_event_consumer_idempotency")
  @@schema("platform")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// STEP 5 — Identity Tables (ADR-036, ADR-055)
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

// ── IAM Person — Universal Human Identity ────────────────────
// The canonical FK target for ALL domain references to a human.
// ADR-055: if the column identifies WHO a person IS → FK(iam_person)
// ADR-036: person can exist without a platform_users account
model IamPerson {
  id                 String     @id @db.Uuid
  firstName          String     @map("first_name")
  lastName           String     @map("last_name")
  middleName         String?    @map("middle_name")
  preferredName      String?    @map("preferred_name")
  suffix             String?
  previousNames      String[]   @map("previous_names")
  dateOfBirth        DateTime?  @map("date_of_birth") @db.Date
  primaryPhone       String?    @map("primary_phone")
  secondaryPhone     String?    @map("secondary_phone")
  workPhone          String?    @map("work_phone")
  phoneTypePrimary   String?    @map("phone_type_primary")
  phoneTypeSecondary String?    @map("phone_type_secondary")
  preferredLanguage  String     @default("en") @map("preferred_language")
  personalEmail      String?    @map("personal_email")
  notes              String?
  profileUpdatedAt   DateTime?  @map("profile_updated_at") @db.Timestamptz()
  nationalIdHash     String?    @map("national_id_hash")
  personType         PersonType @map("person_type")
  isActive           Boolean    @default(true) @map("is_active")
  mergedIntoId       String?    @map("merged_into_id") @db.Uuid
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz()

  // Relations
  mergedInto        IamPerson?         @relation("PersonMerge", fields: [mergedIntoId], references: [id])
  mergedFrom        IamPerson[]        @relation("PersonMerge")
  account           PlatformUser?
  studentProfile    PlatformStudent?
  familyMembers     FamilyMember[]
  volunteerProfile  VolunteerProfile?
  substituteProfile SubstituteProfile?
  managedAccounts   PlatformUser[]     @relation("ManagedByPerson")

  @@index([nationalIdHash])
  @@index([personType, isActive])
  @@index([mergedIntoId])
  @@map("iam_person")
  @@schema("platform")
}

enum PersonType {
  STAFF
  STUDENT
  GUARDIAN
  VOLUNTEER
  SUBSTITUTE
  ALUMNI
  EXTERNAL

  @@schema("platform")
}

// ── Platform Users — Authentication Accounts ─────────────────
// One row per login credential holder.
// ADR-036: person_id links every account to its human identity.
// ADR-055: domain tables use FK(platform_users) ONLY for auth/audit columns.
//
// Persona registration — isMinorAccount + managedByPersonId support
// parent-managed child accounts (COPPA / FERPA): under-13 accounts are
// created by a parent during the "add child" flow and the parent is the
// sole authorised manager until the child ages up to self-service.
model PlatformUser {
  id                String        @id @db.Uuid
  personId          String        @unique @map("person_id") @db.Uuid
  accountStatus     AccountStatus @default(ACTIVE) @map("account_status")
  accountType       AccountType   @default(HUMAN) @map("account_type")
  email             String        @unique
  displayName       String?       @map("display_name")
  avatarUrl         String?       @map("avatar_url")
  mfaEnabled        Boolean       @default(false) @map("mfa_enabled")
  isMinorAccount    Boolean       @default(false) @map("is_minor_account")
  managedByPersonId String?       @map("managed_by_person_id") @db.Uuid
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  lastSeenAt        DateTime?     @map("last_seen_at") @db.Timestamptz()

  person              IamPerson           @relation(fields: [personId], references: [id])
  managedBy           IamPerson?          @relation("ManagedByPerson", fields: [managedByPersonId], references: [id])
  federatedIdentities FederatedIdentity[]

  @@index([personId])
  @@index([email])
  @@index([managedByPersonId])
  @@map("platform_users")
  @@schema("platform")
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  LOCKED
  PENDING_VERIFICATION
  DEACTIVATED

  @@schema("platform")
}

enum AccountType {
  HUMAN
  SERVICE_ACCOUNT

  @@schema("platform")
}

// ── Platform Students — Student Identity Projection ──────────
// Portable across school transfers. Denormalised PII for zero-latency lookup.
// Authoritative identity lives in iam_person; this is a projection.
// Synced via person.identity.updated Kafka event (ADR-059).
model PlatformStudent {
  id                String    @id @db.Uuid
  personId          String    @unique @map("person_id") @db.Uuid
  firstName         String    @map("first_name")
  lastName          String    @map("last_name")
  dateOfBirth       DateTime? @map("date_of_birth") @db.Date
  nationalIdHash    String?   @map("national_id_hash")
  isActive          Boolean   @default(true) @map("is_active")
  dataSubjectIsSelf Boolean   @default(false) @map("data_subject_is_self")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  person IamPerson @relation(fields: [personId], references: [id])

  @@index([nationalIdHash])
  @@map("platform_students")
  @@schema("platform")
}

// ── Platform Family Children ─────────────────────────────────
// Parent's view of their children, captured BEFORE any school
// relationship exists. Three lifecycle states:
//   PLACEHOLDER  — parent added name+DOB; no canonical account exists
//   PENDING_LINK — invite code generated/emailed; awaiting acceptance
//   LINKED       — person_id set; child has a canonical iam_person
//
// Only LINKED children can be enrolled / messaged / invoiced. The
// UNIQUE (family_id, person_id) constraint is enforced via a partial
// index that ignores NULL person_id so multiple PLACEHOLDER children
// can coexist in the same family.
model PlatformFamilyChild {
  id           String    @id @db.Uuid
  familyId     String    @map("family_id") @db.Uuid
  personId     String?   @map("person_id") @db.Uuid
  firstName    String    @map("first_name")
  lastName     String    @map("last_name")
  dateOfBirth  DateTime? @map("date_of_birth") @db.Date
  gender       String?
  status       String    @default("PLACEHOLDER")
  inviteCode   String?   @map("invite_code")
  inviteEmail  String?   @map("invite_email")
  inviteSentAt DateTime? @map("invite_sent_at") @db.Timestamptz()
  linkedAt     DateTime? @map("linked_at") @db.Timestamptz()
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime? @map("updated_at") @db.Timestamptz()

  @@index([familyId, status])
  @@index([personId])
  @@index([inviteCode])
  @@map("platform_family_children")
  @@schema("platform")
}

// ── Platform Personas ────────────────────────────────────────
// Cached set of persona rows per person. Derived from projection
// tables (platform_family_children LINKED, hr_employees, sis_students,
// sub_profiles, alm_profiles, grp_members) and refreshed by
// PersonaResolutionService on persona-changing actions and on login.
//
// schoolId is null for platform-wide personas (SUBSTITUTE, COMMUNITY,
// or a PARENT whose children aren't yet enrolled anywhere). The
// UNIQUE (person_id, type, COALESCE(school_id, sentinel)) constraint
// is declared via raw SQL in the migration — Prisma can't express it.
model PlatformPersona {
  id        String   @id @db.Uuid
  personId  String   @map("person_id") @db.Uuid
  type      String
  schoolId  String?  @map("school_id") @db.Uuid
  label     String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@index([personId, isActive])
  @@index([personId, type])
  @@index([schoolId])
  @@map("platform_personas")
  @@schema("platform")
}

// ── Platform Invitations ─────────────────────────────────────
// Generic invite envelope for employee offers, child-link codes,
// parent-link from school, and substitute onboarding. token is the
// shareable secret:
//   CHILD_LINK         — 8-char alphanumeric (parent-friendly)
//   EMPLOYEE/SUBSTITUTE/PARENT_LINK — UUID v7 (URL-embedded)
//
// metadata is the type-specific payload (position_id, family_child_id,
// student_person_id, etc.) consumed by the invitation acceptance flow.
model PlatformInvitation {
  id              String    @id @db.Uuid
  type            String
  token           String    @unique
  inviterPersonId String    @map("inviter_person_id") @db.Uuid
  targetEmail     String?   @map("target_email")
  targetPersonId  String?   @map("target_person_id") @db.Uuid
  metadata        Json?     @db.JsonB
  status          String    @default("PENDING")
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz()
  acceptedAt      DateTime? @map("accepted_at") @db.Timestamptz()
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  @@index([inviterPersonId, status])
  @@index([targetEmail])
  @@index([status, expiresAt])
  @@map("platform_invitations")
  @@schema("platform")
}

// ── Platform Families — Cross-School Family Identity ─────────
// Enables cross-school sibling detection (tenant schemas cannot JOIN).
// Synced by FamilyMemberSyncWorker from sis_family_members events.
model PlatformFamily {
  id                 String   @id @db.Uuid
  name               String?
  addressLine1       String?  @map("address_line1")
  addressLine2       String?  @map("address_line2")
  city               String?
  state              String?
  postalCode         String?  @map("postal_code")
  country            String?
  homePhone          String?  @map("home_phone")
  homeLanguage       String   @default("en") @map("home_language")
  mailingAddressSame Boolean  @default(true) @map("mailing_address_same")
  mailingLine1       String?  @map("mailing_line1")
  mailingLine2       String?  @map("mailing_line2")
  mailingCity        String?  @map("mailing_city")
  mailingState       String?  @map("mailing_state")
  mailingPostalCode  String?  @map("mailing_postal_code")
  mailingCountry     String?  @map("mailing_country")
  notes              String?
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  members FamilyMember[]

  @@map("platform_families")
  @@schema("platform")
}

// ── Family Members ───────────────────────────────────────────
// One row per (household, person). person_id is UNIQUE — a person belongs
// to at most one household. role drives the household-edit gate
// (HEAD_OF_HOUSEHOLD or SPOUSE can edit shared fields per HouseholdsService).
// Partial UNIQUE INDEX on (family_id) WHERE is_primary_contact = true is
// declared via raw SQL in the migration; Prisma can't express it natively.
model FamilyMember {
  id               String     @id @db.Uuid
  familyId         String     @map("family_id") @db.Uuid
  // personId is nullable to support PLACEHOLDER / PENDING_INVITE
  // guardians the parent has named but who haven't accepted yet.
  // PG UNIQUE treats NULLs as distinct, so the @unique + composite
  // unique still enforce one-active-row-per-person while allowing
  // many placeholders.
  personId         String?    @unique @map("person_id") @db.Uuid
  memberRole       MemberRole @map("member_role")
  isPrimaryContact Boolean    @default(false) @map("is_primary_contact")
  // Lifecycle: PLACEHOLDER → PENDING_INVITE → ACTIVE. ACTIVE is the
  // default so legacy rows that pre-date this column read correctly.
  status           String     @default("ACTIVE")
  firstName        String?    @map("first_name")
  lastName         String?    @map("last_name")
  email            String?
  inviteCode       String?    @map("invite_code")
  inviteSentAt     DateTime?  @map("invite_sent_at") @db.Timestamptz()
  joinedAt         DateTime   @default(now()) @map("joined_at") @db.Timestamptz()
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  family PlatformFamily @relation(fields: [familyId], references: [id], onDelete: Cascade)
  person IamPerson?     @relation(fields: [personId], references: [id])

  @@unique([familyId, personId])
  @@map("platform_family_members")
  @@schema("platform")
}

enum MemberRole {
  PARENT
  GUARDIAN
  STUDENT
  SIBLING
  OTHER
  HEAD_OF_HOUSEHOLD
  SPOUSE
  CHILD
  GRANDPARENT
  OTHER_GUARDIAN

  @@schema("platform")
}

// ── Volunteer Profiles (ADR-032) ─────────────────────────────
// Cross-school visibility via direct platform schema read.
model VolunteerProfile {
  id                    String                 @id @db.Uuid
  personId              String                 @unique @map("person_id") @db.Uuid
  accountId             String?                @map("account_id") @db.Uuid
  phone                 String?
  backgroundCheckStatus BackgroundCheckStatus? @map("background_check_status")
  backgroundCheckRef    String?                @map("background_check_ref")
  backgroundCheckDate   DateTime?              @map("background_check_date") @db.Date
  certifications        Json?                  @db.JsonB
  availabilityNotes     String?                @map("availability_notes")
  isActive              Boolean                @default(true) @map("is_active")
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz()

  person IamPerson @relation(fields: [personId], references: [id])

  @@map("platform_volunteer_profiles")
  @@schema("platform")
}

// ── Substitute Profiles (ADR-014 forward-compat + P2-9 marketplace) ──
// Platform-portable profile per ADR-029. Tenant sub_school_pool + sub_job_*
// + sub_assignments + sub_ratings + sub_pay_rates carry soft UUID refs to
// SubstituteProfile.id per ADR-001/020. The legacy ADR-014 columns
// (phone, backgroundCheck*, certifications JSONB, gradeRange single string,
// dailyRate, subjectQualifications) are retained additively per the
// project's "no DROP COLUMN" policy and are nullable. Service code
// reads/writes the P2-9 columns (displayName, bio, gradeLevels TEXT[],
// subjectAreas TEXT[], yearsExperience, isAvailable, profilePhotoS3Key,
// overallRating, totalAssignments). maxDistanceMiles is reused as the
// canonical max-travel column (P2-9 plan calls it max_travel_miles).
model SubstituteProfile {
  id                    String                 @id @db.Uuid
  personId              String                 @unique @map("person_id") @db.Uuid
  accountId             String?                @map("account_id") @db.Uuid
  phone                 String?
  backgroundCheckStatus BackgroundCheckStatus? @map("background_check_status")
  backgroundCheckRef    String?                @map("background_check_ref")
  backgroundCheckDate   DateTime?              @map("background_check_date") @db.Date
  certifications        Json?                  @db.JsonB
  subjectQualifications Json?                  @map("subject_qualifications") @db.JsonB
  gradeRange            String?                @map("grade_range")
  maxDistanceMiles      Int?                   @map("max_distance_miles")
  dailyRate             Decimal?               @map("daily_rate") @db.Decimal(8, 2)
  isActive              Boolean                @default(true) @map("is_active")
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz()

  // P2-9 columns
  displayName       String?  @map("display_name")
  bio               String?
  gradeLevels       String[] @default([]) @map("grade_levels")
  subjectAreas      String[] @default([]) @map("subject_areas")
  yearsExperience   Int?     @map("years_experience")
  isAvailable       Boolean  @default(true) @map("is_available")
  profilePhotoS3Key String?  @map("profile_photo_s3_key")
  overallRating     Decimal? @map("overall_rating") @db.Decimal(2, 1)
  totalAssignments  Int      @default(0) @map("total_assignments")
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  person       IamPerson                 @relation(fields: [personId], references: [id])
  credentials  PlatformSubCredential[]
  availability PlatformSubAvailability[]
  preferences  PlatformSubPreference[]

  @@index([isAvailable])
  @@map("platform_substitute_profiles")
  @@schema("platform")
}

// ── P2-9 Sub Marketplace platform tables ─────────────────────────────

model PlatformSubCredential {
  id                 String    @id @db.Uuid
  substituteId       String    @map("substitute_id") @db.Uuid
  credentialType     String    @map("credential_type")
  credentialName     String    @map("credential_name")
  issuingBody        String?   @map("issuing_body")
  issueDate          DateTime? @map("issue_date") @db.Date
  expiryDate         DateTime? @map("expiry_date") @db.Date
  documentS3Key      String?   @map("document_s3_key")
  verificationStatus String    @default("PENDING") @map("verification_status")
  verifiedBy         String?   @map("verified_by") @db.Uuid
  verifiedAt         DateTime? @map("verified_at") @db.Timestamptz()
  verificationNotes  String?   @map("verification_notes")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  substitute SubstituteProfile @relation(fields: [substituteId], references: [id], onDelete: Cascade)

  @@index([substituteId, credentialType, verificationStatus, expiryDate])
  @@map("platform_sub_credentials")
  @@schema("platform")
}

model PlatformSubAvailability {
  id               String    @id @db.Uuid
  substituteId     String    @map("substitute_id") @db.Uuid
  availabilityType String    @map("availability_type")
  dayOfWeek        Int?      @map("day_of_week") @db.SmallInt
  specificDate     DateTime? @map("specific_date") @db.Date
  startTime        DateTime? @map("start_time") @db.Time(0)
  endTime          DateTime? @map("end_time") @db.Time(0)
  notes            String?
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  substitute SubstituteProfile @relation(fields: [substituteId], references: [id], onDelete: Cascade)

  @@index([substituteId, availabilityType])
  @@map("platform_sub_availability")
  @@schema("platform")
}

model PlatformSubPreference {
  id             String   @id @db.Uuid
  substituteId   String   @map("substitute_id") @db.Uuid
  schoolId       String   @map("school_id") @db.Uuid
  preferenceType String   @map("preference_type")
  reason         String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  substitute SubstituteProfile @relation(fields: [substituteId], references: [id], onDelete: Cascade)

  @@unique([substituteId, schoolId])
  @@index([schoolId, preferenceType])
  @@map("platform_sub_preferences")
  @@schema("platform")
}

enum BackgroundCheckStatus {
  PENDING
  PASSED
  FLAGGED
  EXPIRED

  @@schema("platform")
}

// ── Identity Provider Configuration ──────────────────────────
// Each school can have its own IdP (Google, Microsoft, SAML, etc.)
model IdentityProvider {
  id                    String       @id @db.Uuid
  schoolId              String?      @map("school_id") @db.Uuid
  name                  String
  providerType          ProviderType @map("provider_type")
  issuerUrl             String?      @map("issuer_url")
  clientIdEncrypted     String?      @map("client_id_encrypted")
  metadataUrl           String?      @map("metadata_url")
  isActive              Boolean      @default(true) @map("is_active")
  trustLevel            TrustLevel   @default(MEDIUM) @map("trust_level")
  autoProvisionAccounts Boolean      @default(false) @map("auto_provision_accounts")
  createdAt             DateTime     @default(now()) @map("created_at") @db.Timestamptz()

  school              School?             @relation(fields: [schoolId], references: [id])
  federatedIdentities FederatedIdentity[]

  @@map("iam_identity_provider")
  @@schema("platform")
}

enum ProviderType {
  GOOGLE
  MICROSOFT
  SAML
  OIDC
  LOCAL
  LDAP

  @@schema("platform")
}

enum TrustLevel {
  HIGH
  MEDIUM
  LOW

  @@schema("platform")
}

// ── Federated Identity — IdP-to-Account Mapping ──────────────
// Links external IdP identities to platform_users accounts.
model FederatedIdentity {
  id            String     @id @db.Uuid
  userId        String     @map("user_id") @db.Uuid
  providerId    String     @map("provider_id") @db.Uuid
  externalId    String     @map("external_id")
  externalEmail String?    @map("external_email")
  syncStatus    SyncStatus @default(SYNCED) @map("sync_status")
  conflictNote  String?    @map("conflict_note")
  lastSyncAt    DateTime?  @map("last_sync_at") @db.Timestamptz()
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz()

  user     PlatformUser     @relation(fields: [userId], references: [id])
  provider IdentityProvider @relation(fields: [providerId], references: [id])

  @@unique([providerId, externalId])
  @@index([userId])
  @@map("iam_federated_identity")
  @@schema("platform")
}

enum SyncStatus {
  SYNCED
  CONFLICT
  PENDING

  @@schema("platform")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// STEP 6 — IAM Core (ADR-036)
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

// ── Roles ────────────────────────────────────────────────────
// Named collections of permissions. System roles seeded at provisioning.
// Schools create custom roles (e.g. Department Head).
model Role {
  id          String   @id @db.Uuid
  schoolId    String?  @map("school_id") @db.Uuid
  name        String
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  rolePermissions RolePermission[]
  assignments     IamRoleAssignment[]

  @@unique([schoolId, name])
  @@map("roles")
  @@schema("platform")
}

// ── Permissions ──────────────────────────────────────────────
// Resource:action pairs. e.g. att-001:read, att-001:write, att-001:admin
// All @RequirePermission checks use these codes, never role names.
model Permission {
  id          String   @id @db.Uuid
  code        String   @unique
  resource    String
  action      String
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  rolePermissions RolePermission[]

  @@index([resource, action])
  @@map("permissions")
  @@schema("platform")
}

// ── Role-Permission Mapping ──────────────────────────────────
model RolePermission {
  id           String @id @db.Uuid
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@map("role_permissions")
  @@schema("platform")
}

// ── Scope Types ──────────────────────────────────────────────
// Fixed vocabulary: PLATFORM, DISTRICT, SCHOOL, DEPARTMENT, CLASS, ACTIVITY
model IamScopeType {
  id                String  @id @db.Uuid
  code              String  @unique
  label             String
  allowsChildScopes Boolean @default(true) @map("allows_child_scopes")
  isSystem          Boolean @default(true) @map("is_system")

  scopes IamScope[]

  @@map("iam_scope_type")
  @@schema("platform")
}

// ── Scopes ───────────────────────────────────────────────────
// A specific instance: e.g. "Lincoln Elementary" (SCHOOL scope),
// "Math Department" (DEPARTMENT scope), "Period 3 Algebra" (CLASS scope)
model IamScope {
  id            String   @id @db.Uuid
  scopeTypeId   String   @map("scope_type_id") @db.Uuid
  entityId      String   @map("entity_id") @db.Uuid
  entityTable   String   @map("entity_table")
  label         String
  parentScopeId String?  @map("parent_scope_id") @db.Uuid
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()

  scopeType   IamScopeType              @relation(fields: [scopeTypeId], references: [id])
  parentScope IamScope?                 @relation("ScopeHierarchy", fields: [parentScopeId], references: [id])
  childScopes IamScope[]                @relation("ScopeHierarchy")
  assignments IamRoleAssignment[]
  accessCache IamEffectiveAccessCache[]

  @@unique([scopeTypeId, entityId])
  @@index([parentScopeId])
  @@index([entityId])
  @@map("iam_scope")
  @@schema("platform")
}

// ── Role Assignments ─────────────────────────────────────────
// The sole mechanism for granting access. Always scoped + time-bounded.
model IamRoleAssignment {
  id                String           @id @db.Uuid
  accountId         String           @map("account_id") @db.Uuid
  roleId            String           @map("role_id") @db.Uuid
  scopeId           String           @map("scope_id") @db.Uuid
  effectiveFrom     DateTime         @default(now()) @map("effective_from") @db.Timestamptz()
  effectiveTo       DateTime?        @map("effective_to") @db.Timestamptz()
  status            AssignmentStatus @default(ACTIVE)
  source            AssignmentSource
  sourceRefId       String?          @map("source_ref_id") @db.Uuid
  assignedBy        String?          @map("assigned_by") @db.Uuid
  approvalRequestId String?          @map("approval_request_id") @db.Uuid
  notes             String?
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz()

  role  Role     @relation(fields: [roleId], references: [id])
  scope IamScope @relation(fields: [scopeId], references: [id])

  @@index([accountId, status])
  @@index([scopeId, roleId, status])
  @@index([effectiveTo])
  @@map("iam_role_assignment")
  @@schema("platform")
}

enum AssignmentStatus {
  ACTIVE
  SUSPENDED
  EXPIRED
  REVOKED

  @@schema("platform")
}

enum AssignmentSource {
  MANUAL
  HR_SYNC
  SIS_DERIVED
  GUARDIAN_RELATIONSHIP
  WORKFLOW_APPROVAL
  EMERGENCY

  @@schema("platform")
}

// ── Role Assignment History ──────────────────────────────────
// Immutable audit of every state change on an assignment.
model IamRoleAssignmentHistory {
  id                  String               @id @db.Uuid
  assignmentId        String               @map("assignment_id") @db.Uuid
  changedBy           String?              @map("changed_by") @db.Uuid
  changeType          AssignmentChangeType @map("change_type")
  previousStatus      AssignmentStatus?    @map("previous_status")
  newStatus           AssignmentStatus?    @map("new_status")
  previousEffectiveTo DateTime?            @map("previous_effective_to") @db.Timestamptz()
  newEffectiveTo      DateTime?            @map("new_effective_to") @db.Timestamptz()
  reason              String?
  changedAt           DateTime             @map("changed_at") @db.Timestamptz()

  @@index([assignmentId, changedAt])
  @@map("iam_role_assignment_history")
  @@schema("platform")
}

enum AssignmentChangeType {
  CREATED
  ACTIVATED
  SUSPENDED
  REVOKED
  EXPIRED
  EXTENDED
  SOURCE_UPDATED

  @@schema("platform")
}

// ── Relationship Access Rules ────────────────────────────────
// How person-to-person relationships translate into access grants.
// e.g. "Guardian of student → Parent Portal role at student's school"
model IamRelationshipAccessRule {
  id               String   @id @db.Uuid
  relationshipType String   @map("relationship_type")
  targetRoleId     String   @map("target_role_id") @db.Uuid
  scopeDerivation  String   @map("scope_derivation")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@map("iam_relationship_access_rule")
  @@schema("platform")
}

// ── Effective Access Cache ───────────────────────────────────
// Materialized permission set per account per scope.
// The SOLE source for hot-path permission checks (ADR-036).
// Direct JOINs across assignment→role→permission are FORBIDDEN on request path.
model IamEffectiveAccessCache {
  id                    String   @id @db.Uuid
  accountId             String   @map("account_id") @db.Uuid
  scopeId               String   @map("scope_id") @db.Uuid
  permissionCodes       String[] @map("permission_codes")
  computedAt            DateTime @map("computed_at") @db.Timestamptz()
  assignmentVersionHash String   @map("assignment_version_hash")

  scope IamScope @relation(fields: [scopeId], references: [id])

  @@unique([accountId, scopeId])
  @@index([accountId])
  @@map("iam_effective_access_cache")
  @@schema("platform")
}

// ── Access Change Events ─────────────────────────────────────
// IAM-specific immutable audit log. Every grant, revoke, status change.
model IamAccessChangeEvent {
  id           String                @id @db.Uuid
  accountId    String                @map("account_id") @db.Uuid
  eventType    AccessChangeEventType @map("event_type")
  actorId      String?               @map("actor_id") @db.Uuid
  scopeId      String?               @map("scope_id") @db.Uuid
  roleId       String?               @map("role_id") @db.Uuid
  assignmentId String?               @map("assignment_id") @db.Uuid
  metadata     Json?                 @db.JsonB
  eventAt      DateTime              @map("event_at") @db.Timestamptz()

  @@index([accountId, eventAt(sort: Desc)])
  @@index([eventType, eventAt(sort: Desc)])
  @@map("iam_access_change_event")
  @@schema("platform")
}

enum AccessChangeEventType {
  ACCOUNT_CREATED
  ACCOUNT_SUSPENDED
  ACCOUNT_REACTIVATED
  ACCOUNT_LOCKED
  ROLE_GRANTED
  ROLE_REVOKED
  ROLE_SUSPENDED
  ROLE_EXPIRED
  GUARDIAN_ACCESS_PROVISIONED
  GUARDIAN_ACCESS_REVOKED
  MFA_ENROLLED
  MFA_REMOVED
  EMERGENCY_ACCESS_GRANTED
  EMERGENCY_ACCESS_REVOKED

  @@schema("platform")
}

// ── Auth Events ──────────────────────────────────────────────
// Authentication-specific events. Separate from access changes.
model IamAuthEvent {
  id            String        @id @db.Uuid
  accountId     String?       @map("account_id") @db.Uuid
  providerId    String?       @map("provider_id") @db.Uuid
  eventType     AuthEventType @map("event_type")
  ipAddressHash String?       @map("ip_address_hash")
  userAgentHash String?       @map("user_agent_hash")
  sessionId     String?       @map("session_id") @db.Uuid
  failureReason String?       @map("failure_reason")
  eventAt       DateTime      @map("event_at") @db.Timestamptz()

  @@index([accountId, eventAt(sort: Desc)])
  @@index([eventType, eventAt(sort: Desc)])
  @@map("iam_auth_event")
  @@schema("platform")
}

enum AuthEventType {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  MFA_CHALLENGE_ISSUED
  MFA_CHALLENGE_PASSED
  MFA_CHALLENGE_FAILED
  SESSION_CREATED
  SESSION_TERMINATED
  TOKEN_REFRESHED
  TOKEN_REVOKED
  ACCOUNT_LOCKED_AUTO

  @@schema("platform")
}

// ── Service Principals ───────────────────────────────────────
// Machine identities for service-to-service auth.
model IamServicePrincipal {
  id          String   @id @db.Uuid
  name        String   @unique
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@map("iam_service_principal")
  @@schema("platform")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// CYCLE 3 STEP 3 — Communications Platform Support
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

// ── Push Tokens ──────────────────────────────────────────────
// One row per (user, device). Cross-tenant by design — a single
// platform_user can hold roles in multiple schools and we want
// one push registration to reach them everywhere they have access.
// Soft FK to platform_users (no DB FK per ADR-001/020 — kept loose
// so a deleted account doesn't cascade through device records).
model PlatformPushToken {
  id             String       @id @db.Uuid
  platformUserId String       @map("platform_user_id") @db.Uuid
  deviceId       String       @map("device_id")
  platform       PushPlatform
  token          String
  isActive       Boolean      @default(true) @map("is_active")
  lastSeenAt     DateTime?    @map("last_seen_at") @db.Timestamptz()
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  @@unique([platformUserId, deviceId])
  @@index([platformUserId, isActive])
  @@index([token])
  @@map("platform_push_tokens")
  @@schema("platform")
}

enum PushPlatform {
  IOS
  ANDROID
  WEB

  @@schema("platform")
}

// ── Dead Letter Queue ────────────────────────────────────────
// Kafka messages that failed every consumer retry. Holds the raw
// payload + headers so an operator can replay or triage. Cross-tenant
// because a DLQ row may originate from any tenant, the operator is
// platform-scoped, and the failure handler runs above the request path.
model PlatformDlqMessage {
  id            String    @id @db.Uuid
  topic         String
  partition     Int
  kafkaOffset   BigInt    @map("kafka_offset")
  consumerGroup String    @map("consumer_group")
  eventId       String?   @map("event_id")
  tenantId      String?   @map("tenant_id") @db.Uuid
  payload       Json      @db.JsonB
  headers       Json?     @db.JsonB
  errorMessage  String    @map("error_message")
  errorClass    String?   @map("error_class")
  retryCount    Int       @default(0) @map("retry_count")
  firstFailedAt DateTime  @default(now()) @map("first_failed_at") @db.Timestamptz()
  lastFailedAt  DateTime  @default(now()) @map("last_failed_at") @db.Timestamptz()
  resolvedAt    DateTime? @map("resolved_at") @db.Timestamptz()
  resolvedBy    String?   @map("resolved_by") @db.Uuid
  resolution    String?

  @@index([topic, lastFailedAt(sort: Desc)])
  @@index([consumerGroup, lastFailedAt(sort: Desc)])
  @@index([tenantId, lastFailedAt(sort: Desc)])
  @@index([resolvedAt])
  @@map("platform_dlq_messages")
  @@schema("platform")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// REVIEW-FINAL P4 — Soft FK Reference Health
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
//
// Per ADR-001/020/028, tenant tables MUST NOT carry DB-enforced FKs
// to platform.* tables. Cross-schema soft refs (UUID columns +
// app-layer validation) are the canonical pattern. The trade-off is
// that orphans can accumulate when a parent platform row is removed
// without coordinated tenant cleanup — the schema does not detect or
// prevent this.
//
// `platform_reference_health` is the registry + scan log that closes
// the loop. The ReferenceHealthScannerWorker (Cycle 33+) periodically
// counts orphans for each registered (source_schema, source_table,
// source_column → target_schema, target_table) tuple and writes one
// row per scan. Operators query this table via the platform admin
// dashboard to see drift over time + investigate spikes.
//
// The registry of which refs to scan is config-driven inside the
// worker (apps/api/src/observability/reference-health/registry.ts).
// Adding a new soft-FK pattern is a one-line registry entry; no
// schema change required.
// P2-H2 Step 1.1 — restructured as registry-per-reference per the
// hardening plan. The new shape adds `target_module` (which CampusOS
// domain owns the target table) and `severity` (CRITICAL / WARNING /
// INFO — drives alerting thresholds: CRITICAL refs page on any
// orphan; WARNING refs page on > 5; INFO refs surface in the
// dashboard but never page). The UNIQUE constraint on the source
// triple makes this a registry: the Phase 2 SoftIntegrityHealthWorker
// UPSERTs into a single row per registered reference. The existing
// `scanned_at` column is retained (rather than renamed to
// `last_checked_at`) so the in-flight worker continues to function
// during the migration; the column is semantically the same — most
// recent scan time per reference.
model PlatformReferenceHealth {
  id              String   @id @db.Uuid
  // The soft-FK source — e.g. "tenant_demo" + "fac_work_orders" +
  // "requested_by". target identifies what it should resolve to —
  // e.g. "platform" + "platform_users" + "id".
  sourceSchema    String   @map("source_schema")
  sourceTable     String   @map("source_table")
  sourceColumn    String   @map("source_column")
  targetSchema    String   @map("target_schema")
  targetTable     String   @map("target_table")
  targetColumn    String   @default("id") @map("target_column")
  targetModule    String   @default("platform") @map("target_module")
  severity        String   @default("WARNING")
  // Scan output. `total_rows` is the source-table row count at scan
  // time; `orphan_count` is the number of source rows whose
  // source_column does not resolve in target. `sample_orphan_ids` is
  // a small JSON array (capped at 20) for operator triage.
  totalRows       Int      @map("total_rows")
  orphanCount     Int      @map("orphan_count")
  sampleOrphanIds Json     @default("[]") @map("sample_orphan_ids") @db.JsonB
  scannedAt       DateTime @default(now()) @map("scanned_at") @db.Timestamptz()
  scanDurationMs  Int      @map("scan_duration_ms")

  @@unique([sourceSchema, sourceTable, sourceColumn], map: "platform_reference_health_source_uq")
  @@index([sourceSchema, sourceTable, scannedAt(sort: Desc)])
  @@index([orphanCount(sort: Desc), scannedAt(sort: Desc)])
  @@index([severity, orphanCount(sort: Desc)])
  @@map("platform_reference_health")
  @@schema("platform")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// REVIEW-FINAL P2 — Transactional Outbox
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
//
// Producer-side reliability for safety-critical Kafka events.
// Without this, `KafkaProducerService.emit()` is best-effort: a
// broker outage at the moment of emit silently drops the event,
// even though the originating database transaction has committed.
// For finance, breach notification, SHI auto-escalation, and
// emergency alert fan-out, that's not acceptable.
//
// Pattern: callers use `OutboxService.enqueueInTx(tx, ...)` instead
// of `KafkaProducerService.emit()`. The outbox row commits with the
// caller's transaction. A separate worker
// (OutboxPublisherWorker) polls outbox, publishes via the producer,
// and deletes the row on success. Failure leaves the row for the
// next poll. The `published_at IS NULL` partial index keeps the
// poll query fast even when millions of events have been processed.
model PlatformOutbox {
  id           String    @id @db.Uuid
  topic        String
  // The wire-shape ADR-057 envelope JSON. The publisher worker
  // sends this verbatim — no re-wrapping. correlation_id, event_id,
  // tenant_id, etc. are already inside.
  envelope     Json      @db.JsonB
  // Optional partition key (forwarded to kafkajs as the message
  // key). Falls back to a random UUID when null.
  messageKey   String?   @map("message_key")
  // Tenant context for observability + admin filtering.
  tenantId     String?   @map("tenant_id") @db.Uuid
  sourceModule String    @map("source_module")
  // Lifecycle. published_at is set by the worker after a successful
  // producer.send. failed_at + last_error are set when a publish
  // attempt errors; the worker bumps attempt_count and retries on
  // the next poll until MAX_OUTBOX_ATTEMPTS (default 10), at which
  // point the row stays at failed_at and an operator must intervene.
  publishedAt  DateTime? @map("published_at") @db.Timestamptz()
  failedAt     DateTime? @map("failed_at") @db.Timestamptz()
  attemptCount Int       @default(0) @map("attempt_count")
  lastError    String?   @map("last_error")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  // Partial index so the publisher worker's poll query can prune
  // most rows efficiently. Once published_at is set, the row drops
  // out of the index; an archive worker can hard-delete published
  // rows older than N days as housekeeping.
  @@index([createdAt], map: "platform_outbox_pending_idx")
  @@index([tenantId, createdAt(sort: Desc)])
  @@index([failedAt], map: "platform_outbox_failed_idx")
  @@map("platform_outbox")
  @@schema("platform")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// CYCLE 23 — Curriculum Standards (Platform-Seeded Frameworks)
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
//
// National standards frameworks (Common Core State Standards, Next
// Generation Science Standards) live in the platform schema so a
// framework update is one migration, not one per tenant. Schools
// adopt platform frameworks via the tenant
// cur_school_framework_adoptions table. School-custom frameworks
// live in tenant cur_standards_frameworks + cur_standards.
//
// The cur_unit_standards.standard_id column resolves from EITHER
// platform OR tenant via app-layer dual resolution per ADR-001/020.

model CurStandardsFrameworkPlatform {
  id        String   @id @db.Uuid
  name      String   @unique
  body      String?
  region    String?
  version   String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  standards CurStandardPlatform[]

  @@map("cur_standards_frameworks_platform")
  @@schema("platform")
}

model CurStandardPlatform {
  id          String   @id @db.Uuid
  frameworkId String   @map("framework_id") @db.Uuid
  code        String
  description String
  gradeBand   String?  @map("grade_band")
  domain      String?
  cluster     String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  framework CurStandardsFrameworkPlatform @relation(fields: [frameworkId], references: [id], onDelete: Cascade)

  @@unique([frameworkId, code])
  @@index([frameworkId, gradeBand])
  @@map("cur_standards_platform")
  @@schema("platform")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// P2-8b — Athletics Officials Marketplace (ADR-063)
// Officials are portable across schools and live in the platform
// schema so a single official can work games in multiple tenants
// without per-school duplication. Tenant ath_official_assignments
// rows carry a soft UUID ref to platform_official_profiles.id per
// ADR-001/020 (no DB-enforced FK across the schema boundary).
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

model PlatformOfficialProfile {
  id                  String    @id @db.Uuid
  personId            String    @unique @map("person_id") @db.Uuid
  sports              String[]  @db.Text
  certificationLevel  String?   @map("certification_level")
  certificationBody   String?   @map("certification_body")
  certificationExpiry DateTime? @map("certification_expiry") @db.Date
  yearsExperience     Int?      @map("years_experience")
  maxTravelMiles      Int?      @map("max_travel_miles")
  baseFee             Decimal?  @map("base_fee") @db.Decimal(8, 2)
  isAvailable         Boolean   @default(true) @map("is_available")
  bio                 String?
  contactEmail        String?   @map("contact_email")
  contactPhone        String?   @map("contact_phone")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  availability PlatformOfficialAvailability[]

  @@index([isAvailable])
  @@map("platform_official_profiles")
  @@schema("platform")
}

model PlatformOfficialAvailability {
  id                String    @id @db.Uuid
  officialProfileId String    @map("official_profile_id") @db.Uuid
  availableDate     DateTime  @map("available_date") @db.Date
  startTime         DateTime? @map("start_time") @db.Time(0)
  endTime           DateTime? @map("end_time") @db.Time(0)
  isAvailable       Boolean   @default(true) @map("is_available")
  notes             String?
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  profile PlatformOfficialProfile @relation(fields: [officialProfileId], references: [id], onDelete: Cascade)

  @@unique([officialProfileId, availableDate, startTime])
  @@index([availableDate, isAvailable])
  @@map("platform_official_availability")
  @@schema("platform")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// P2-23 — Accreditation Frameworks & Standards (M85)
// Platform-seeded national/international accreditation frameworks
// (AdvancED/Cognia, IB MYP, CIS, NEASC, WASC, SACS, MSA) and their
// standards live in the platform schema, seeded once by the
// idempotent platform seeder and shared across every tenant.
// School-custom frameworks live in tenant acc_frameworks. The
// acc_evidence_items / acc_self_study_ratings / acc_action_plans
// tables carry standard_id as a SOFT INTEGRITY reference per
// ADR-001/020 — the service layer resolves it to either
// acc_standards_platform OR a tenant custom standard at read time.
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

model AccFrameworkPlatform {
  id           String   @id @db.Uuid
  name         String   @unique
  abbreviation String   @unique
  organisation String
  description  String?
  version      String?
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  standards AccStandardPlatform[]

  @@map("acc_frameworks_platform")
  @@schema("platform")
}

model AccStandardPlatform {
  id            String   @id @db.Uuid
  frameworkId   String   @map("framework_id") @db.Uuid
  standardCode  String   @map("standard_code")
  domain        String
  standardText  String   @map("standard_text")
  guidanceNotes String?  @map("guidance_notes")
  sortOrder     Int      @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()

  framework AccFrameworkPlatform @relation(fields: [frameworkId], references: [id], onDelete: Cascade)

  @@unique([frameworkId, standardCode])
  @@index([frameworkId, domain, sortOrder])
  @@map("acc_standards_platform")
  @@schema("platform")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// P2-H2 Step 1.4 — Platform Signature Requests
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
//
// Cross-module digital signature requests. Originally referenced as
// `signature_request_id` soft FKs in IEP/504 activation, telehealth
// consent, field-trip consent, and HR contract sign-off, but the table
// itself was never created. This table closes those soft refs.
//
// Lifecycle:
//   PENDING → SIGNED (signed_at, signed_by populated)
//   PENDING → DECLINED (declined_at, decline_reason populated)
//   PENDING → EXPIRED (expires_at < now() at last cron sweep)
//   PENDING → REVOKED (admin revoke; revoked_at populated)
//
// Cross-tenant by design (tenant_id stamps origin) so a signer who is a
// guardian in tenant A signing a document on a student in tenant B
// (rare in practice — multi-school families) can still complete.
model PlatformSignatureRequest {
  id              String    @id @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  documentType    String    @map("document_type")
  documentS3Key   String?   @map("document_s3_key")
  signerPersonId  String    @map("signer_person_id") @db.Uuid
  signerEmail     String    @map("signer_email")
  status          String    @default("PENDING")
  expiresAt       DateTime? @map("expires_at") @db.Timestamptz()
  signedAt        DateTime? @map("signed_at") @db.Timestamptz()
  signedBy        String?   @map("signed_by") @db.Uuid
  signatureMethod String?   @map("signature_method")
  declinedAt      DateTime? @map("declined_at") @db.Timestamptz()
  declineReason   String?   @map("decline_reason")
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz()
  revokedBy       String?   @map("revoked_by") @db.Uuid
  sourceModule    String    @map("source_module")
  sourceRefId     String    @map("source_ref_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  @@index([tenantId, status, createdAt(sort: Desc)])
  @@index([signerPersonId, status])
  @@index([sourceModule, sourceRefId])
  @@map("platform_signature_requests")
  @@schema("platform")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// P2-H2 Step 1.5 — Partition Management Health (ADR-024)
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
//
// Per-partition health tracker for the ~290 partitioned tables across
// every tenant. The partition-management worker (Phase 3 ops) writes
// one row per (schema, parent_table, partition_name) UPSERT after each
// scan. Operators query for stale partitions, missing future partitions,
// and oversized partitions via the platform admin dashboard.
//
// Status values:
//   ACTIVE      — partition is current; window covers today (when range)
//   FUTURE      — partition window is entirely in the future
//   PAST        — partition window is entirely in the past (cold storage)
//   OVERSIZE    — partition row count > 50M (sharding signal)
//   MISSING     — gap detected in expected window sequence
model PartitionMgmtHealth {
  id                String   @id @db.Uuid
  schemaName        String   @map("schema_name")
  parentTable       String   @map("parent_table")
  partitionName     String   @map("partition_name")
  partitionStrategy String   @map("partition_strategy")
  rangeStart        String?  @map("range_start")
  rangeEnd          String?  @map("range_end")
  hashRemainder     Int?     @map("hash_remainder")
  rowCount          BigInt   @default(0) @map("row_count")
  sizeBytes         BigInt   @default(0) @map("size_bytes")
  status            String   @default("ACTIVE")
  scannedAt         DateTime @default(now()) @map("scanned_at") @db.Timestamptz()
  scanDurationMs    Int      @default(0) @map("scan_duration_ms")

  @@unique([schemaName, parentTable, partitionName])
  @@index([status, scannedAt(sort: Desc)])
  @@index([schemaName, parentTable])
  @@map("partition_mgmt_health")
  @@schema("platform")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// P2-H2 Step 1.6 — Compliance FERPA Requests
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
//
// FERPA records request log. A student / guardian / past-student can
// formally request copies of education records under FERPA; the school
// has 45 days to respond. Stored at the platform tier because requests
// can span multiple schools the student attended.
//
// Status lifecycle:
//   RECEIVED → IN_PROGRESS → COMPLETED (records released)
//   RECEIVED → DENIED (with denial_reason; appealable)
//   COMPLETED → CONTESTED (requester challenges accuracy; opens amendment workflow)
model ComplianceFerpaRequest {
  id                   String    @id @db.Uuid
  tenantId             String    @map("tenant_id") @db.Uuid
  schoolId             String?   @map("school_id") @db.Uuid
  requesterPersonId    String    @map("requester_person_id") @db.Uuid
  requesterRelation    String    @map("requester_relation")
  studentPersonId      String    @map("student_person_id") @db.Uuid
  requestType          String    @map("request_type")
  recordsScope         String    @map("records_scope")
  status               String    @default("RECEIVED")
  receivedAt           DateTime  @default(now()) @map("received_at") @db.Timestamptz()
  deadlineAt           DateTime  @map("deadline_at") @db.Timestamptz()
  acknowledgedAt       DateTime? @map("acknowledged_at") @db.Timestamptz()
  completedAt          DateTime? @map("completed_at") @db.Timestamptz()
  releasedRecordsS3Key String?   @map("released_records_s3_key")
  deniedAt             DateTime? @map("denied_at") @db.Timestamptz()
  denialReason         String?   @map("denial_reason")
  notes                String?
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  @@index([tenantId, status, deadlineAt])
  @@index([requesterPersonId, receivedAt(sort: Desc)])
  @@index([studentPersonId, receivedAt(sort: Desc)])
  @@map("compliance_ferpa_requests")
  @@schema("platform")
}
